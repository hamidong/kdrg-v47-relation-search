# KDRG cross-platform checkout byte policy
# All tracked text keeps LF bytes on Windows and Linux.
# Windows command scripts are the only CRLF exceptions.
* text eol=lf

.gitattributes text eol=lf
.gitignore text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

